# ==============================================================================
# DocuFlow AI - Local Environment Variables
# Copy this file to .env before starting Docker Compose or running the app:
#   cp .env.example .env
# ==============================================================================

# SQL Server Configuration
MSSQL_SA_PASSWORD=DocuFlow_Dev_Pass123!
SQL_SERVER_PORT=1433
SQL_CONNECTION_STRING=Server=localhost,1433;Database=DocuFlowDb;User Id=sa;Password=DocuFlow_Dev_Pass123!;TrustServerCertificate=True;MultipleActiveResultSets=true;

# Azurite (Azure Blob Storage Emulator) Configuration
AZURITE_BLOB_PORT=10000
AZURITE_QUEUE_PORT=10001
AZURITE_TABLE_PORT=10002
# Standard Azurite well-known connection string for local development
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true;DevelopmentStorageProxyUri=http://127.0.0.1;
AZURE_STORAGE_BLOB_CONTAINER=documents

# Application Settings (Local Dev - WSL2 Host)
# Note: Use 'localhost'/'127.0.0.1' when running API/Worker in WSL2 host,
# or 'sqlserver'/'azurite' when running inside docker-compose network.
ASPNETCORE_ENVIRONMENT=Development
PORT=5000
FRONTEND_PORT=5173

# Authentication (JWT - Local Dev Only)
JWT_SECRET_KEY=CHANGE_ME_DEV_ONLY_MIN_32_CHARACTERS_LONG
JWT_ISSUER=DocuFlow.Api
JWT_AUDIENCE=DocuFlow.Client

# Azure AI Document Intelligence
DOCUMENT_INTELLIGENCE_USE_MOCK=true
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

