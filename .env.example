# ==============================================================================
# DocuFlow AI - Environment Variables Template
# Copy this file to .env before starting Docker Compose:
#   cp .env.example .env
# Never commit the real .env file.
# ==============================================================================

# PostgreSQL (primary database + processing queue)
POSTGRES_DB=docuflow
POSTGRES_USER=docuflow
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
POSTGRES_PORT=5432
POSTGRES_CONNECTION_STRING=Host=localhost;Port=5432;Database=docuflow;Username=docuflow;Password=CHANGE_ME_STRONG_POSTGRES_PASSWORD

# Seconds a leased queue message stays invisible before being retried (default 300)
DOCUMENT_QUEUE_VISIBILITY_SECONDS=300

# Private document storage (local filesystem / Docker volume)
# Leave DOCUMENT_STORAGE_PATH empty to use ~/.local/share/DocuFlow/storage when running API/Worker locally.
# Inside docker-compose it is fixed to /data/storage (volume docuflow_document_storage).
DOCUMENT_STORAGE_PATH=
DOCUMENT_STORAGE_CONTAINER=documents

# Application & Production Hosting Settings
ASPNETCORE_ENVIRONMENT=Production
PORT=5000
FRONTEND_PORT=8080
FRONTEND_ORIGIN=http://localhost:8080
VITE_API_BASE_URL=

# Authentication (JWT - REQUIRED in non-development environments, min 32 chars)
JWT_SECRET_KEY=CHANGE_ME_STRONG_RANDOM_JWT_SECRET_MIN_32_CHARS
JWT_ISSUER=DocuFlow.Api
JWT_AUDIENCE=DocuFlow.Client

# Google Gemini (document extraction + executive summary + AI agent)
# Keep this empty in templates; set your real key only in untracked .env or secret manager.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
DOCUMENT_INTELLIGENCE_FORCE_MOCK=false

# Optional second-stage AI analysis (sends extracted field values, not files, to Gemini)
AI_ANALYSIS_ENABLED=false
AI_ANALYSIS_USE_MOCK=false
GEMINI_TIMEOUT_SECONDS=30
